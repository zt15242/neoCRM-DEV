{
  "name": "neocrm-desktop",
  "version": "1.8.56",
  "description": "NeoCRM 桌面端开发者工具，支持多环境切换、OAuth2 授权登录与会话管理",
  "main": "dist-electron/main.js",
  "scripts": {
    "clean:electron": "node scripts/clean-electron-output.mjs",
    "predev": "npm run clean:electron && npm run prepare:neo-cli && npm run build:opencode-workspace",
    "prebuild": "npm run clean:electron && npm run prepare:neo-cli && npm run build:opencode-workspace",
    "prepare:neo-cli": "node scripts/prepare-neo-cli.mjs",
    "test:neo-cli": "node scripts/test-bundled-neo-cli.mjs",
    "build:opencode-workspace": "node scripts/build-opencode-workspace.mjs",
    "test:agent-model": "tsc -p tsconfig.agent.json && node scripts/test-agent-model-gateway.mjs && node scripts/test-agent-runtime-safety.mjs && node scripts/test-workspace-mutation.mjs && node scripts/test-project-editor.mjs && node scripts/test-meeting-minutes.mjs && node scripts/test-data-migration-suite.mjs",
    "dev": "vite",
    "build": "tsc && vite build && npm run build:opencode-workspace",
    "start": "electron .",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg.mjs",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:all": "npm run build && electron-builder -mw",
    "release": "node scripts/release.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "test:agent-storage": "node scripts/test-agent-storage.mjs",
    "test:opencode-workspace": "node scripts/test-opencode-workspace.mjs",
    "test:agent-runtime": "node scripts/verify-agent-runtime-isolation.mjs dist-electron",
    "test:migration": "node scripts/test-data-migration-suite.mjs"
  },
  "keywords": [
    "neocrm",
    "electron",
    "desktop",
    "oauth2"
  ],
  "author": "NeoCRM Team",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@opencode/ai": "2.2.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@thednp/dommatrix": "3.1.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "axios": "^1.20.0",
    "cfb": "1.2.2",
    "codemirror": "^6.0.2",
    "docx": "^9.11.0",
    "dompurify": "3.4.17",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "form-data": "^4.0.6",
    "imapflow": "^2.9.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "mailparser": "^3.12.4",
    "mermaid": "12.3.0",
    "mongodb": "^6.22.0",
    "nodemailer": "^10.2.1",
    "pdfjs-dist": "6.5.438",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "saxes": "6.0.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.3",
    "word-extractor": "1.0.4",
    "ws": "^8.22.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "bun": "1.4.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "type": "module"
}
