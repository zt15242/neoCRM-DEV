+import { Route, Router, type BaseRouterProps } from "@solidjs/router"
+import { lazy, Suspense, type Component, type ParentProps } from "solid-js"
+import { AppInterface } from "./app"
+import { SessionRouteFrame } from "./session/session-frame"
+import { LayoutProvider } from "./shell/state/layout"
+import { SettingsSurfaceProvider } from "./settings/surface"
+import { PluginAttachment } from "./runtime/plugin/root"
+import { TargetServerRoute } from "./shell/routes/routes"
+
+const Session = lazy(() => import("./session/route").then((module) => ({ default: module.TargetSessionRouteContent })))
+
+function EmbeddedRouter(props: BaseRouterProps) {
+  const Root = props.root as Component<ParentProps>
+
+  return (
+    <Router root={Root}>
+      <Route component={EmbeddedLayout}>
+        <Route path="/server/:serverKey/session/:id" component={() => <EmbeddedSession />} />
+      </Route>
+    </Router>
+  )
+}
+
+function EmbeddedLayout(props: ParentProps) {
+  return (
+    <LayoutProvider>
+      <SettingsSurfaceProvider>
+        <PluginAttachment>{props.children}</PluginAttachment>
+      </SettingsSurfaceProvider>
+    </LayoutProvider>
+  )
+}
+
+function EmbeddedSession() {
+  return (
+    <SessionRouteFrame>
+      <Suspense fallback={<div class="min-h-0 flex-1" role="status" />}>
+        <TargetServerRoute>
+          <Session />
+        </TargetServerRoute>
+      </Suspense>
+    </SessionRouteFrame>
+  )
+}
+
+export function EmbeddedAppInterface(props: Parameters<typeof AppInterface>[0]) {
+  return <AppInterface {...props} router={EmbeddedRouter} />
+}
