+function createBridgeFetch(): typeof fetch {
+  if (window.parent === window) return globalThis.fetch.bind(globalThis)
+
+  return async (input, init) => {
+    const request = new Request(input, init)
+    const contentType = request.headers.get("content-type") || ""
+    const binaryBody = !["GET", "HEAD"].includes(request.method) && contentType.includes("application/octet-stream")
+    const body = request.method === "GET" || request.method === "HEAD" || binaryBody ? undefined : await request.text()
+    const bodyBase64 = binaryBody ? bytesToBase64(await request.arrayBuffer()) : undefined
+    const channel = new MessageChannel()
+
+    return new Promise<Response>((resolve, reject) => {
+      const port = channel.port1
+      let streamController: ReadableStreamDefaultController<Uint8Array> | undefined
+      const cleanup = () => {
+        request.signal.removeEventListener("abort", abort)
+        port.close()
+      }
+      const abort = () => {
+        port.postMessage({ kind: "abort" })
+        cleanup()
+        reject(new DOMException("The operation was aborted", "AbortError"))
+      }
+
+      port.onmessage = (event: MessageEvent) => {
+        const message = event.data
+        if (message.kind === "response") {
+          if (!message.stream) {
+            cleanup()
+            const responseBody = message.bodyBase64 ? base64ToBytes(message.bodyBase64) : message.body ?? null
+            resolve(new Response(responseBody, { status: message.status, headers: message.headers }))
+            return
+          }
+
+          const stream = new ReadableStream<Uint8Array>({
+            start(controller) { streamController = controller },
+            cancel() { port.postMessage({ kind: "abort" }); cleanup() },
+          })
+          resolve(new Response(stream, { status: message.status, headers: message.headers }))
+          return
+        }
+
+        if (message.kind === "chunk") {
+          streamController?.enqueue(new TextEncoder().encode(message.chunk))
+          return
+        }
+
+        if (message.kind === "end") {
+          streamController?.close()
+          cleanup()
+          return
+        }
+
+        if (message.kind === "error") {
+          const error = new Error(message.message || "NeoCRM API bridge failed")
+          if (streamController) streamController.error(error)
+          else reject(error)
+          cleanup()
+        }
+      }
+      port.start()
+
+      if (request.signal.aborted) return abort()
+      request.signal.addEventListener("abort", abort, { once: true })
+      window.parent.postMessage({
+        type: "neo-opencode-rpc",
+        url: request.url,
+        method: request.method,
+        headers: [...request.headers.entries()],
+        body,
+        bodyBase64,
+      }, "*", [channel.port2])
+    })
   }
 }
 
+function bytesToBase64(bytes: ArrayBuffer) {
+  const data = new Uint8Array(bytes)
+  let binary = ""
+  for (let offset = 0; offset < data.length; offset += 0x8000) {
+    binary += String.fromCharCode(...data.subarray(offset, offset + 0x8000))
+  }
+  return btoa(binary)
+}
+
+function base64ToBytes(value: string) {
+  const binary = atob(value)
+  const bytes = new Uint8Array(binary.length)
+  for (let index = 0; index < binary.length; index++) bytes[index] = binary.charCodeAt(index)
+  return bytes
+}
